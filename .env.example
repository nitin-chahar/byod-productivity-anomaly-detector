# ==============================================================
# BYOD Productivity Logger & Anomaly Detection - Environment Variables
# ==============================================================
# Copy this file to '.env' and populate your sensitive values.
# NEVER commit your actual '.env' file to version control!

# --- Flask Server Settings ---
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=True

# --- Monitoring & Anomaly Detection Thresholds ---
# Time limit in seconds for non-productive websites before triggering an alert (default: 300s = 5m)
ALERT_THRESHOLD=300

# Baseline duration in seconds for task-switching analysis (default: 120s = 2m)
SWITCH_THRESHOLD=120

# Isolation Forest contamination rate (proportion of expected anomalies, e.g. 0.05 = 5%)
IF_CONTAMINATION=0.05

# Statistical Z-Score threshold for rapid category switching (default: 3.0 standard deviations)
Z_SCORE_THRESHOLD=3.0

# --- SMTP Email Dispatcher Settings ---
# Outgoing SMTP server details (e.g. smtp.gmail.com, smtp.office365.com, etc.)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# The sender email address used to dispatch alert emails
SMTP_SENDER_EMAIL=try.nitinchahar@gmail.com

# For Gmail, generate a 16-character App Password 
SMTP_APP_PASSWORD=xsmu zzoq arlg uzah

